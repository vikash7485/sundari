# Copy this file to ".env" and fill in the values.

# --- Supabase (Project Settings -> API) ---
# Leave these empty to run the site in DEMO mode (changes are only saved in your own browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Owner's admin email. The admin login screen pre-fills it, so the owner only types the password.
VITE_ADMIN_EMAIL=

# Your live website address, without a trailing slash (used for Open Graph / Google).
VITE_SITE_URL=https://www.your-domain.in

# Password for the admin panel in DEMO mode only (ignored once Supabase is connected).
VITE_DEMO_ADMIN_PASSWORD=sundari-demo
